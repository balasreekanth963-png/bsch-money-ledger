# ==============================================
# BSCH MONEY LEDGER - Environment Variables
# ==============================================
# Copy this file to ".env.local" and fill in your real values.
# NEVER commit ".env.local" or any file containing real secrets.

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anonymous/public key (Project Settings -> API -> anon public)
# Safe to expose to the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (Project Settings -> API -> service_role secret)
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Never import in client components.
# Only used later for admin/server scripts (e.g. seeding demo data, future BSCH Admin panel).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App metadata
NEXT_PUBLIC_APP_NAME="BSCH Money Ledger"
NEXT_PUBLIC_APP_BRAND="BSCH - Bala Sir Career Hub Consultancy"
